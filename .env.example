# ---------------------------------------------------------------------------
# Copia este fichero a .env.local y rellena los valores.
# En Vercel hay que declararlas también: .env.local no se sube al repo.
# ---------------------------------------------------------------------------

# Dominio canónico. Sin él, los enlaces canónicos, el sitemap y las miniaturas
# de Open Graph apuntarán a padelalbufera.com aunque el dominio real sea otro.
NEXT_PUBLIC_SITE_URL=https://www.padelalbufera.com

# --- Medición --------------------------------------------------------------

# Google Tag Manager. ID del contenedor, empieza por GTM-.
NEXT_PUBLIC_GTM_ID=

# CMP externa (Axeptio o Didomi). VACÍO = modo básico: nada de Google se
# descarga hasta que el banner propio recibe un sí.
# RELLENO = el `consent default` restrictivo se emite inline en el <head>, se
# carga la CMP y GTM entra detrás. El banner propio se desactiva solo.
#   Axeptio → NEXT_PUBLIC_CMP_ID = clientId
#             NEXT_PUBLIC_CMP_SRC = https://static.axept.io/sdk-slim.js
#   Didomi  → NEXT_PUBLIC_CMP_ID = apiKey
#             NEXT_PUBLIC_CMP_SRC = https://sdk.privacy-center.org/<apiKey>/loader.js
NEXT_PUBLIC_CMP_ID=
NEXT_PUBLIC_CMP_SRC=

# --- Contacto, por idioma --------------------------------------------------

# WhatsApp: SOLO DÍGITOS con prefijo internacional, sin "+" (formato wa.me).
NEXT_PUBLIC_WHATSAPP_ES=34614207633
NEXT_PUBLIC_WHATSAPP_FR=

# Teléfono: formato E.164 CON "+" (formato del href tel:).
# Si usas números de desvío de Google Ads, pon aquí el número real: la
# sustitución dinámica reemplaza el texto en los nodos .js-phone-number.
NEXT_PUBLIC_PHONE_ES=+34614207633
NEXT_PUBLIC_PHONE_FR=

# --- Solo servidor. NUNCA con prefijo NEXT_PUBLIC_ -------------------------

# Destino de los registros de atribución (gclid + código de referencia).
# Hoy: URL de un Google Apps Script que escribe en una hoja de cálculo.
# Mañana: el endpoint del CRM. El Route Handler reenvía el objeto tal cual,
# así que cambiar de destino es cambiar esta variable.
# Si está vacío, la cookie y el código siguen funcionando: solo no se registra.
LEAD_WEBHOOK_URL=

# Sal para hashear la IP en el registro de consentimientos. Sin ella, el hash
# de una IPv4 es reversible por fuerza bruta en minutos.
CONSENT_IP_SALT=
