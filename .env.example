# --- Medición ---------------------------------------------------------------
# Ninguna de estas herramientas se carga sin consentimiento del usuario
# (Consent Mode básico). Sin valor, el cargador correspondiente no hace nada.

# Google Tag Manager. ID del contenedor, empieza por GTM-.
NEXT_PUBLIC_GTM_ID=

# Meta Pixel. Solo dígitos.
NEXT_PUBLIC_META_PIXEL_ID=

# --- Solo servidor. NUNCA con prefijo NEXT_PUBLIC_ --------------------------

# Token de la Conversions API de Meta (Gestor de Eventos > Configuración).
META_CAPI_ACCESS_TOKEN=

# Versión de la Graph API. Vigente en julio de 2026: v25.0 (publicada 18/02/2026).
# Meta publica versión nueva cada pocos meses y retira las antiguas: revisar
# https://developers.facebook.com/docs/graph-api/changelog antes de actualizar.
META_GRAPH_API_VERSION=v25.0

# Código de evento de prueba, para validar en el Gestor de Eventos.
# Dejar VACÍO en producción o los eventos no contarán como reales.
META_TEST_EVENT_CODE=

# Sal para hashear la IP en el registro de consentimientos. Sin ella el hash
# de una IPv4 es reversible por fuerza bruta en minutos.
CONSENT_IP_SALT=
